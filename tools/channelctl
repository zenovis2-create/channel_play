#!/usr/bin/env python3
"""Channel Play project control entrypoint."""

from __future__ import annotations

import sys
import os
from pathlib import Path


def _bootstrap() -> None:
    root = Path(__file__).resolve().parents[1]
    root_text = str(root)
    if root_text not in sys.path:
        sys.path.insert(0, root_text)


def main() -> int:
    _bootstrap()
    from tools.studio.company.cli import main as company_main
    from tools.studio.company.agent_runner import main as agent_main
    from tools.studio.company.entrypoints import dispatch_top_level
    from tools.studio.host_runner import ensure_token as ensure_host_runner_token
    from tools.studio.host_runner import serve as serve_host_runner
    from tools.studio.workspace_server import serve

    args = sys.argv[1:]
    if not args:
        return _print_help()

    command = args[0]
    rest = args[1:]

    if command == "status":
        return company_main(["status", *rest])

    if command == "company":
        return company_main(rest)

    if command == "agent":
        return agent_main(rest)

    if command in {"unity", "game", "open", "capture", "feedback", "asset", "world", "gdx", "simworld", "sim-agent", "sim-acceptance"}:
        return dispatch_top_level(command, rest)

    if command == "studio":
        return _studio(rest, serve)

    if command == "host-runner":
        return _host_runner(rest, serve_host_runner, ensure_host_runner_token)

    if command in {"help", "-h", "--help"}:
        return _print_help()

    print(f"Unknown command: {command}", file=sys.stderr)
    print("Run: tools/channelctl help", file=sys.stderr)
    return 2


