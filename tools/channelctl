def _studio(args: list[str], serve_func) -> int:
    if any(arg in {"help", "-h", "--help"} for arg in args):
        print("Usage: tools/channelctl studio serve [port] [--host HOST] | open [port] [--host HOST]")
        return 0
    mode = args[0] if args else "serve"
    if mode not in {"serve", "open"}:
        print("Usage: tools/channelctl studio serve [port] [--host HOST] | open [port] [--host HOST]", file=sys.stderr)
        return 2
    port = 8766
    host = "127.0.0.1"
    if "--host" in args:
        idx = args.index("--host")
        if idx + 1 >= len(args):
            print("Missing value for --host", file=sys.stderr)
            return 2
        host = args[idx + 1]
    elif os.environ.get("CHANNEL_PLAY_STUDIO_HOST"):
        host = os.environ["CHANNEL_PLAY_STUDIO_HOST"]
    positional = [arg for index, arg in enumerate(args[1:], start=1) if arg != "--host" and args[index - 1] != "--host"]
    if positional:
        try:
            port = int(positional[0])
        except ValueError:
            print(f"Invalid port: {positional[0]}", file=sys.stderr)
            return 2
    serve_func(host=host, port=port, open_browser=(mode == "open"))
    return 0


def _host_runner(args: list[str], serve_func, token_func) -> int:
    if any(arg in {"help", "-h", "--help"} for arg in args):
        print("Usage: tools/channelctl host-runner token | serve [port]")
        return 0
    mode = args[0] if args else "serve"
    if mode == "token":
        path = token_func()
        print(f"Host runner token ready: {path}")
        return 0
    if mode != "serve":
        print("Usage: tools/channelctl host-runner token | serve [port]", file=sys.stderr)
        return 2
    port = 8788
    if len(args) > 1:
        try:
            port = int(args[1])
        except ValueError:
            print(f"Invalid port: {args[1]}", file=sys.stderr)
            return 2
    serve_func(port=port)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
